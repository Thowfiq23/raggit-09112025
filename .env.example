# ===========================================
# RAGgit Environment Variables
# ===========================================
# Copy this file to .env.local and fill in your values
# cp .env.example .env.local

# ===========================================
# Supabase Configuration
# ===========================================
# Get these from your Supabase project settings:
# https://app.supabase.com/project/_/settings/api

# Your Supabase project URL
SCALEUP_SUPABASE_URL=https://your-project-ref.supabase.co

# Supabase anon (public) key - safe to expose in browser
SCALEUP_SUPABASE_ANON_KEY=your-anon-key-here

# Supabase service role key - KEEP SECRET, server-side only
SCALEUP_SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# ===========================================
# AI Services
# ===========================================

# Jina AI API Key - for generating embeddings
# Get from: https://jina.ai/
SCALEUP_JINA_API_KEY=your-jina-api-key-here

# Groq API Key - for LLM inference
# Get from: https://console.groq.com/
GROQ_API_KEY=your-groq-api-key-here

# ===========================================
# GitHub (Optional)
# ===========================================
# GitHub Personal Access Token for higher API rate limits
# Without token: 60 requests/hour
# With token: 5,000 requests/hour
# Create at: https://github.com/settings/tokens
GITHUB_TOKEN=your-github-pat-here

# ===========================================
# Notes
# ===========================================
# - All SCALEUP_* variables are specific to this project
# - The NEXT_PUBLIC_* prefix would expose vars to the browser,
#   but this project maps SCALEUP_* vars in next.config.ts
# - Never commit .env.local to version control
